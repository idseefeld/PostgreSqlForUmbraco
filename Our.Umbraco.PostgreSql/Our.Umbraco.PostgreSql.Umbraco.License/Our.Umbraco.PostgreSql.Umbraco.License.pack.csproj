<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<PackageId>Our.Umbraco.PostgreSql.Umbraco.License</PackageId>
		<Title>Umbraco CMS - Persistence - Umbraco License - PostgreSQL</Title>
		<Description>Adds support for Umbraco License with PostgreSQL.</Description>
		<StaticWebAssetBasePath>\</StaticWebAssetBasePath>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".pack", ""))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Our.Umbraco.PostgreSql" Version="[17.5.0,18.0.0)" />
	</ItemGroup>

</Project>
