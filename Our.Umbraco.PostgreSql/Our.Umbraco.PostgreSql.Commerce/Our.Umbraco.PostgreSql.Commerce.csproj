<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Our.Umbraco.PostgreSql.Umbraco.Commerce</PackageId>
    <Company>-</Company>
    <Authors>Dirk Seefeld</Authors>
    <PackageIcon>upostgresqlfix.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Product>PostgreSQL Provider for Umbraco Commerce</Product>
    <PackageTags>umbraco, postgresql, community</PackageTags>
    <Title>Umbraco CMS - Persistence - Umbraco.Commerce - PostgreSQL</Title>
    <Description>Adds support for Umbraco.Commerce with PostgreSQL.</Description>
    <StaticWebAssetBasePath>\</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="readme.md" Pack="true" PackagePath="\" />
    <Content Include="..\Our.Umbraco.PostgreSql\upostgresqlfix.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Our.Umbraco.PostgreSql\Our.Umbraco.PostgreSql.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Umbraco.Commerce.Persistence" />
  </ItemGroup>

</Project>
