<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Our.Umbraco.PostgreSql.EFCore</PackageId>
		<Title>Umbraco CMS - Persistence - Entity Framework Core - PostgreSQL</Title>
		<Description>Adds support for Entity Framework Core PostgreSQL to Umbraco CMS.</Description>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".pack", ""))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[11.0.0-rc.3,12.0.0)" />
	  <PackageReference Include="Umbraco.Cms.Persistence.EFCore" Version="[19.0.0-beta1,19.1.0)" />
	</ItemGroup>


</Project>
