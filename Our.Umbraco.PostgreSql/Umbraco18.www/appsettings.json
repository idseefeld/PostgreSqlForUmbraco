{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true,
        "Id": "de808cb8-c3ea-4458-9d84-1a6a58d8bd62"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Runtime": {
        "Mode": "Production"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
      },
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "UnattendedUserName": "admin",
        "UnattendedUserEmail": "admin@admin.com",
        "UnattendedUserPassword": "adminadmin"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44362",
        "_ApplicationUrlDetection": "FirstRequest"
      }
    }
  },
  "ConnectionStrings": {
  }
}